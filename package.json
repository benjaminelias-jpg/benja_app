{
  "name": "hook-crm",
  "version": "0.1.0",
  "private": true,
  "description": "CRM de Instagram para infoproductores: atribucion de contenido, pipelines, automatizaciones y analitica.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "rm -rf .data && npm run db:migrate && npm run db:seed",
    "setup": "npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "key:create": "tsx src/db/create-key.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "webhooks:retry": "tsx src/db/retry-webhooks.ts",
    "db:bootstrap": "tsx src/db/bootstrap.ts",
    "vercel-build": "tsx src/db/deploy.ts && next build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@vercel/blob": "^2.9.0",
    "@xyflow/react": "^13.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "nanoid": "^6.0.2",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
