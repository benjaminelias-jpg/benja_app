# ---------------------------------------------------------------------------
# Hook CRM — configuración
#
# Todo tiene un valor por defecto que funciona en local: podés copiar este
# archivo a `.env` y arrancar sin tocar nada.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Base de datos
# ---------------------------------------------------------------------------
# Si lo dejás vacío, la app usa PGlite: un Postgres real embebido en WASM que
# vive en ./.data/pgdata. Cero instalación, cero Docker.
# Para producción (o para correr varios procesos a la vez) apuntá a un Postgres
# de verdad: Neon, Supabase, RDS, o uno local.
# DATABASE_URL=postgres://usuario:clave@host:5432/hookcrm?sslmode=require

# Carpeta de datos de PGlite (solo aplica si DATABASE_URL está vacío).
# PGLITE_DATA_DIR=.data/pgdata

# URL pública de la app. Se usa para mostrar las URLs de webhook.
APP_URL=http://localhost:3000


# Instagram / Meta
# ---------------------------------------------------------------------------
# Token que Meta envía en el handshake GET al registrar el webhook.
META_VERIFY_TOKEN=hookcrm-dev-verify

# App Secret de Meta. Si está presente, cada POST del webhook se valida con la
# firma X-Hub-Signature-256. Dejalo vacío solo en desarrollo.
# META_APP_SECRET=

# Token de acceso de la cuenta de Instagram Business.
# Sin este token la app entra en modo simulado: los DMs se registran en el CRM
# y en el historial del lead, pero no salen a Instagram. Todo el embudo se
# puede probar igual.
# INSTAGRAM_ACCESS_TOKEN=

# Forzar el modo simulado aunque haya token (útil para probar en producción).
# DRY_RUN_OUTBOUND=true


# ManyChat
# ---------------------------------------------------------------------------
# Secreto compartido que ManyChat manda en el header `x-hook-secret`.
# Si lo dejás vacío, el webhook acepta cualquier payload (solo para desarrollo).
# MANYCHAT_WEBHOOK_SECRET=

# API key de ManyChat, para escribir de vuelta: etiquetar al suscriptor,
# actualizar campos personalizados o disparar flujos desde el CRM.
# MANYCHAT_API_KEY=


# Conexión OAuth de Instagram
# ---------------------------------------------------------------------------
# Meta tiene dos caminos y no son intercambiables. Cuál te toca depende de cómo
# esté dada de alta tu app en el panel de desarrolladores.
#
# Camino A — "Instagram API with Instagram Login"
#   OAuth en www.instagram.com, token de usuario de Instagram (60 días,
#   renovable). Los IDs salen de: App Dashboard → Instagram → API setup with
#   Instagram business login.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# Camino B — "Instagram API with Unified Login"
#   OAuth por Facebook Login for Business, token de sistema del portafolio de
#   negocio. Requiere crear una configuración y usar su config_id.
# META_APP_ID=
# META_CONFIG_ID=
# (META_APP_SECRET ya está más arriba: se usa para las dos cosas)

# Cuál ofrecer por defecto en la pantalla de conexión: instagram_login | unified_login
INSTAGRAM_CONNECTION_METHOD=instagram_login

# Redirect URI a registrar en Meta (se arma solo a partir de APP_URL):
#   <APP_URL>/api/instagram/callback
